BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
BETTER_AUTH_URL=http://localhost:3000

# Public URL of the deployed app (used for metadata and auth trusted origins).
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Leave empty to use a local SQLite file during development.
# For deployment, create a free database at https://turso.tech and paste the values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional social login. Create credentials in the provider consoles.
# Google callback: http://localhost:3000/api/auth/callback/google
# GitHub callback: http://localhost:3000/api/auth/callback/github
# Guide: docs/oauth-setup.md — verify with `npm run auth:check`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
